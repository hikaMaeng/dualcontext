# Not a secret: the service is reachable only on the compose project network and on loopback.
# Crawl4AI binds every interface only when a token is set; dualcontext sends the same value
# (DUALCONTEXT_CRAWLER_TOKEN defaults to it). Change both together to rotate.
CRAWL4AI_API_TOKEN=dualcontext-internal-network-only
CRAWL4AI_NO_CLOUD_NOTICE=1
