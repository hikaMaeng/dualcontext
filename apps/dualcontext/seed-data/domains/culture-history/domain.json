{
  "name": "culture-history",
  "table": "ds_culture_history",
  "dataset": "beomi/KoAlpaca-v1.1a",
  "config": "default",
  "split": "train",
  "license": "라이선스 미표기(허깅페이스 카드에 없음). 네이버 지식iN 질문과 모델 생성 답변이라 사실 확인이 필요하다",
  "limit": 300,
  "filter": "역사|조선|고려|신라|삼국|전쟁|유래|전통|속담|맞춤법|어원",
  "map": {
    "id": "{url}",
    "title": "{instruction}",
    "body": "{output}",
    "embed": "{instruction}\n{output}"
  },
  "researcher": {
    "name": "역사·문화·언어 상식 Q&A",
    "description": "한국과 세계의 역사, 전통과 풍습, 말과 속담의 유래, 맞춤법과 어원 같은 인문 상식 질문에 사람이 답한 기록. 무엇이 언제 어떻게 생겼고 무슨 뜻인지 묻는 질의를 맡는다.",
    "keywords": [
      "역사",
      "조선",
      "유래",
      "전통",
      "속담",
      "어원"
    ],
    "minScore": 0.76
  },
  "procedures": [
    {
      "name": "[인문] 유래와 맥락 정리",
      "appliesWhen": [
        "유래",
        "언제",
        "왜",
        "뜻"
      ],
      "steps": [
        "묻는 대상과 시대를 확정한다",
        "자료에서 유래와 맥락을 찾는다",
        "설이 갈리면 나눈다"
      ],
      "impacts": [
        "유래",
        "시대 맥락",
        "이설"
      ],
      "outputFormat": "시간순 설명"
    },
    {
      "name": "[인문] 뜻과 쓰임 구분",
      "appliesWhen": [
        "뜻",
        "의미",
        "차이"
      ],
      "steps": [
        "표현의 뜻을 모은다",
        "쓰임의 차이를 구분한다"
      ],
      "impacts": [
        "뜻",
        "쓰임 차이"
      ],
      "outputFormat": "뜻 + 예"
    }
  ],
  "link": [
    "근거 신뢰도 점검"
  ]
}
